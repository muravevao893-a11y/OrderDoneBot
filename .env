# Канал, куда публиковать посты. Бот должен быть админом канала.
# Можно указать @username_канала или -1001234567890
CHANNEL_ID=@bio_konstantina

# Твои Telegram ID через запятую. Узнать можно через @userinfobot
ADMIN_IDS=8275949284

# Кнопка под постом. Можно указать свой профиль, бот или Kwork-профиль.
CONTACT_URL=https://kwork.ru/user/konst9nt1n
CONTACT_BUTTON_TEXT=Заказать разработку

DEFAULT_CURRENCY=₽
DB_PATH=data/orders.db

# ========================
# Режим публикации
# ========================
# false = безопасный режим: письмо найдено -> бот присылает тебе предпросмотр -> ты жмёшь «Опубликовать»
# true = полный автомат: письмо найдено -> бот сразу публикует в канал
AUTO_PUBLISH=false

# ========================
# Почта с уведомлениями Kwork через IMAP
# Лучше создать отдельную почту только под уведомления.
# Для Gmail нужен App Password, не обычный пароль.
# ========================
EMAIL_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=reyzin378@gmail.com
IMAP_PASSWORD=vqbe pgoq lgrd xvij
IMAP_FOLDER=INBOX
EMAIL_CHECK_INTERVAL=60

# На первом запуске пропустить старые письма, чтобы бот случайно не выложил прошлые заказы.
EMAIL_SKIP_OLD_ON_FIRST_RUN=true

# Фильтр отправителя. Можно оставить kwork, можно указать точный домен/адрес из письма.
KWORK_SENDER_FILTER=kwork

# Какие слова в теме/тексте считать событием «заказ выполнен».
# После того как пришлёшь мне пример письма от Kwork, эти слова можно точно подогнать.
KWORK_SUCCESS_KEYWORDS=заказ выполнен,заказ завершен,работа принята,покупатель принял заказ,оплата зачислена
KWORK_IGNORE_KEYWORDS=новый заказ,заказ отменен,доработка,арбитраж,сообщение от покупателя
AUTO_PUBLISH=false

